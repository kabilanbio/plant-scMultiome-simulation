#!/bin/bash
#PBS -N rice_paga_trees
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /cabinfs/home/kabilan/data_simulation_comparison/scMultiSim_results/rice_paga_output.log
# ==============================================================================
# run_rice_paga_cluster.pbs
# PBS Job Script for Rice PAGA Lineage Tree Extraction on Ashoka HPC
# Environment: conda activate conda_latest
# ==============================================================================

echo "=========================================================="
echo "Job started on $(hostname) at $(date)"
echo "PBS Job ID: $PBS_JOBID"
echo "Working directory: $PBS_O_WORKDIR"
echo "=========================================================="

# Activate Conda Environment
source ~/.bashrc
conda activate conda_latest

# Define Cluster Directories
CODE_DIR="/cabinfs/home/kabilan/scripts/02_lineage_tree_paga"
INPUT_DIR="/cabinfs/home/kabilan/sc_datasets/rice/featured_datasets_anndata"
STANDARDIZED_DIR="/cabinfs/home/kabilan/sc_datasets/rice/featured_datasets_standardized"
OUTPUT_DIR="/cabinfs/home/kabilan/data_simulation_comparison/scMultiSim_results/rice_paga_results"

mkdir -p "$OUTPUT_DIR"
cd "$CODE_DIR" || exit 1

# Step 1: Export Seurat RDS to Matrix Market / AnnData (if not already done)
echo "[Step 1] Exporting Standardized Datasets to AnnData..."
Rscript export_rice_standardized_to_anndata.R \
  --input_dir "$STANDARDIZED_DIR" \
  --output_dir "$INPUT_DIR" \
  --tissue all

# Step 2: Run PAGA Lineage Tree Reconstruction
echo "[Step 2] Running PAGA Lineage Tree Pipeline..."
python rice_paga_lineage_tree.py \
  --input_dir "$INPUT_DIR" \
  --standardized_dir "$STANDARDIZED_DIR" \
  --output_dir "$OUTPUT_DIR" \
  --tissue all \
  --dpi 600

echo "=========================================================="
echo "Job completed successfully at $(date)"
echo "Output files located in: $OUTPUT_DIR"
echo "=========================================================="
